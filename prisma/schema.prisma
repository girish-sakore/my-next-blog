generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  createdAt DateTime @default(now())
  references String[]
  photos    Photo[]
}

model Photo {
  id        Int      @id @default(autoincrement())
  url       String
  article   Article   @relation(fields: [articleId], references: [id])
  articleId Int
}